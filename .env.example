# ══════════════════════════════════════════════════════════════
#  Label Indeza — Environment Variables Template
#  Copy this file to .env.local and fill in real values.
#  NEVER commit .env.local to git.
# ══════════════════════════════════════════════════════════════

# ── MongoDB Atlas ──────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<appName>

# ── NextAuth ───────────────────────────────────────────────────
NEXTAUTH_SECRET=<generate: openssl rand -base64 32>
NEXTAUTH_URL=https://yourdomain.com

# ── Google OAuth ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=<from console.cloud.google.com>
GOOGLE_CLIENT_SECRET=<from console.cloud.google.com>

# ── Cloudinary (Image & Video storage) ────────────────────────
CLOUDINARY_CLOUD_NAME=<from cloudinary.com dashboard>
CLOUDINARY_API_KEY=<from cloudinary.com dashboard>
CLOUDINARY_API_SECRET=<from cloudinary.com dashboard>

# ── Brevo (Primary email — SMTP relay) ────────────────────────
BREVO_SMTP_LOGIN=<your Brevo account email>
BREVO_SMTP_KEY=<from app.brevo.com → Settings → SMTP & API → Generate SMTP key>

# ── Resend (Fallback email) ────────────────────────────────────
RESEND_API_KEY=<from resend.com → API Keys → Create Key>

# ── Email sender address ───────────────────────────────────────
# Use your verified domain email in production:
EMAIL_FROM=hello@yourdomain.com

# ── Razorpay (Payments) ────────────────────────────────────────
RAZORPAY_KEY_ID=<from razorpay.com → Settings → API Keys>
RAZORPAY_KEY_SECRET=<from razorpay.com → Settings → API Keys>
NEXT_PUBLIC_RAZORPAY_KEY_ID=<same as RAZORPAY_KEY_ID>

# ── Admin Setup ────────────────────────────────────────────────
# Used once to invite the first admin. Use a strong random string.
ADMIN_SETUP_SECRET=<generate: openssl rand -hex 24>
